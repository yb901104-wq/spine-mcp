  "definitions": [
    {
      "name": "spine_retarget_reference_pose",
      "description": "按已审查参考及动作级身份适配。隔离 C2 attached 需完整 expectedRevision；成功时暂存新资产。失败默认报告，显式 diagnosticMode:newStage 可预演/打开独立内存阶段，源绑定不变；未知必要点只保留部分诊断。失败无保存授权，仍需独立视觉审查。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "工作区解析优先级：显式 projectId > 用户当前选择 > 客户端 roots > SPINE_MCP_WORKSPACE > cwd；roots 通知不覆盖用户选择。"
          },
          "expectedRevision": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "documentId": {
                "type": "string"
              },
              "openEpoch": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "sessionId",
              "documentId",
              "openEpoch",
              "revision"
            ]
          },
          "referencePosePath": {
            "type": "string",
            "description": "工作区根目录内的 Spine JSON 文件路径。"
          },
          "visualRigPath": {
            "type": "string",
            "description": "工作区根目录内的 Spine JSON 文件路径。"
          },
          "standardPosePath": {
            "type": "string",
            "description": "工作区根目录内的 Spine JSON 文件路径。"
          },
          "posePath": {
            "type": "string",
            "description": "工作区根目录内的 Spine JSON 文件路径。"
          },
          "sequencePath": {
            "type": "string",
            "description": "工作区根目录内的 Spine JSON 文件路径。"
          },
          "stageId": {
            "type": "string"
          },
          "correspondence": {
            "type": "object",
            "description": "目标 left/right 对应参考 left/right；basis、anatomicalIdentity、projectedOrder 必须明确。"
          },
          "facing": {
            "type": "string",
            "enum": [
              "left",
              "right"
            ]
          },
          "time": {
            "type": "number",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "weapon": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "angle": {
                    "type": "number"
                  },
                  "grips": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "left": {
                        "type": "number"
                      },
                      "right": {
                        "type": "number"
                      }
                    },
                    "required": [
                      "left",
                      "right"
                    ]
                  }
                },
                "required": [
                  "x",
                  "y",
                  "angle",
                  "grips"
                ]
              }
            ]
          },
          "headFromReference": {
            "type": "boolean",
            "default": false,
            "description": "仅在已确认面部锚点可用时从参考适配头部方向。"
          },
          "weaponFromReference": {
            "type": "boolean",
            "default": false,
            "description": "按已确认参考握轴生成假想杆；不替代实际握持审查。"
          },
          "diagnosticMode": {
            "type": "string",
            "enum": [
              "report",
              "newStage"
            ],
            "default": "report",
            "description": "newStage 仅限隔离 C2 attached：参考失败时预演或显式打开独立内存阶段，不改变原文档绑定；默认 report 保持原诊断行为。"
          },
          "reportPath": {
            "type": "string",
            "description": "工作区根目录内的 Spine JSON 文件路径。"
          },
          "detailed": {
            "type": "boolean",
            "default": false,
            "description": "默认返回节点和切片摘要，完整顶点/权重保存在报告中。"
          },
          "dryRun": {
            "type": "boolean",
            "default": true
          },
          "responseDetail": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Host 常用返回默认摘要；full 读取完整数据，内部核验不受影响。"
          }
        },
        "required": [
          "referencePosePath",
          "visualRigPath",
          "standardPosePath",
          "posePath"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "spine_resume_diagnostic_pose",
      "description": "显式恢复独立诊断草稿；默认 dryRun 先列来源、哈希和差异。仅隔离 C2 Host，已有活动文档时必须完整版本。实际恢复采用新 openEpoch，清除旧求解、截图准入、pin 和批准；失败仍不能保存为正式资产。",
      "inputSchema": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string"
          },
          "diagnosticId": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "expectedRevision": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sessionId": {
                "type": "string"
              },
              "documentId": {
                "type": "string"
              },
              "openEpoch": {
                "type": "string"
              },
              "revision": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "sessionId",
              "documentId",
              "openEpoch",
              "revision"
            ]
          },
          "dryRun": {
            "type": "boolean",
            "default": true,
            "description": "默认只预演；false 才改变内存/历史或请求真实提交。"
          },
          "responseDetail": {
            "type": "string",
            "enum": [
              "summary",
              "full"
            ],
            "default": "summary",
            "description": "Host 常用返回默认摘要；full 读取完整数据，内部核验不受影响。"
          }
        },
        "required": [
          "diagnosticId"
        ],
        "additionalProperties": false
      }
    }
  ]
}
